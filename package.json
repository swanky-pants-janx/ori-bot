{
  "name": "ori-bot",
  "productName": "Ori",
  "version": "0.1.0",
  "description": "A tiny AI companion that lives on your desktop.",
  "author": "Janx",
  "private": true,
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev --watch",
    "start": "node scripts/electron-vite.mjs preview",
    "build": "npm run typecheck && node scripts/electron-vite.mjs build",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.13.6",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  }
}
